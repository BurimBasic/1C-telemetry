// Принимает POST /json.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - текст UTF-8.
//
// Возвращаемое значение:
//  HTTPСервисОтвет - UUID записи или отказ.
Функция ПринятьJSON(Запрос)
	Возврат ТЛМ_Сервер.ОбработатьЗапрос(Запрос, "json");
КонецФункции

// Принимает POST /file?name=report.txt.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - исходные байты.
//
// Возвращаемое значение:
//  HTTPСервисОтвет - UUID записи или отказ.
Функция ПринятьФайл(Запрос)
	Возврат ТЛМ_Сервер.ОбработатьЗапрос(Запрос, "file");
КонецФункции

// Обрабатывает GET /ping без записи истории.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - запрос с X-Token.
//
// Возвращаемое значение:
//  HTTPСервисОтвет - подтверждение доступа или отказ.
Функция ПроверитьПодключение(Запрос)
	Возврат ТЛМ_Сервер.ОбработатьЗапрос(Запрос, "ping");
КонецФункции

