// Готовит файл выбранной записи во временном хранилище текущего сеанса.
//
// Параметры:
//  Ключ - РегистрСведенийКлючЗаписи.ТЛМ_ПолученныеФайлы - выбранная запись.
//
// Возвращаемое значение:
//  Структура - Адрес и Имя для штатного скачивания.
//  Неопределено - нет права, записи или доступной копии файла.
Функция ПодготовитьФайл(Знач Ключ) Экспорт
	Если ТипЗнч(Ключ) <> Тип("РегистрСведенийКлючЗаписи.ТЛМ_ПолученныеФайлы")
		Или Не ПравоДоступа("Просмотр", Метаданные.РегистрыСведений.ТЛМ_ПолученныеФайлы) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Идентификатор = Ключ.ИдентификаторСообщения;
	ШаблонUUID = "(?i)\A[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\z";
	Если СтрНайтиПоРегулярномуВыражению(Идентификатор, ШаблонUUID).НачальнаяПозиция = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Файлы.ОригинальноеИмя КАК Имя,
		|	Файлы.РазмерБайт КАК РазмерБайт,
		|	Файлы.ОтносительныйПуть КАК Путь
		|ИЗ
		|	РегистрСведений.ТЛМ_ПолученныеФайлы КАК Файлы
		|ГДЕ
		|	Файлы.Клиент = &Клиент
		|	И Файлы.ИдентификаторСообщения = &Идентификатор";
	Запрос.УстановитьПараметр("Клиент", Ключ.Клиент);
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	Запись = Запрос.Выполнить().Выбрать();
	Если Не Запись.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Имя = Запись.Имя;
	ДопустимоеИмя = ТЛМ_Сервер.ДопустимоеИмяФайла(Имя);
	СтарыйПуть = Идентификатор + ".bin";
	Если Запись.Путь = СтарыйПуть Тогда
		Путь = СтарыйПуть;
		Имя = ?(ДопустимоеИмя, Имя, СтарыйПуть);
	ИначеЕсли ДопустимоеИмя И Запись.Путь = Идентификатор + "/" + Имя Тогда
		Путь = Идентификатор + ПолучитьРазделительПути() + Имя;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

	Каталог = ТЛМ_Сервер.КаталогПриемаФайлов();
	Если Каталог = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПолныйПуть = Каталог + Путь;

	Попытка
		Файл = Новый Файл(ПолныйПуть);
		Если Не Файл.Существует() Или Не Файл.ЭтоФайл() Или Файл.Размер() <> Запись.РазмерБайт Тогда
			Возврат Неопределено;
		КонецЕсли;
		Адрес = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПолныйПуть));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат Новый Структура("Адрес,Имя", Адрес, Имя);
КонецФункции

