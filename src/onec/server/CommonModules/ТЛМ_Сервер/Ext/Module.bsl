#Область ПрограммныйИнтерфейс

// Версия исходников расширения.
// Возвращаемое значение:
//  Строка - версия, например "1.0.2-dev".
Функция Версия() Экспорт
	Возврат "1.0.2-dev";
КонецФункции

// Регистрирует или меняет токен клиента. Сгенерируйте 32 случайных байта вне 1С.
//
// Параметры:
//  Клиент - СправочникСсылка.ТЛМ_Клиенты - существующий клиент.
//  Токен - Строка - 64 строчных шестнадцатеричных символа.
//
// Возвращаемое значение:
//  Структура - статус операции, поле Токен есть только при успехе.
//
// Пример:
//  Статус = ТЛМ_Сервер.СгенерироватьТокен(Клиент, СекретИзНастроек);
Функция СгенерироватьТокен(Знач Клиент, Знач Токен) Экспорт
	Возврат ИзменитьДоступ(Клиент, Истина, Токен);
КонецФункции

// Запрещает новые запросы клиента и очищает его хеш. История сохраняется.
//
// Параметры:
//  Клиент - СправочникСсылка.ТЛМ_Клиенты - существующий клиент.
//
// Возвращаемое значение:
//  Структура - статус операции.
//
// Пример:
//  Статус = ТЛМ_Сервер.ЗаблокироватьКлиента(Клиент);
Функция ЗаблокироватьКлиента(Знач Клиент) Экспорт
	Возврат ИзменитьДоступ(Клиент, Ложь, "");
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Проверяет доступ и направляет запрос в нужный обработчик.
// Параметры:
//  Запрос - HTTPСервисЗапрос - запрос, подготовленный платформой.
//  Маршрут - Строка - "ping", "json" или "file" из модуля HTTP-сервиса.
// Возвращаемое значение:
//  HTTPСервисОтвет - безопасный ответ без путей, секретов и исключений.
Функция ОбработатьЗапрос(Знач Запрос, Знач Маршрут) Экспорт
	Попытка
		Клиент = КлиентПоТокену(Запрос.Заголовки.Получить("X-Token"));
		Если Клиент = Неопределено Тогда
			Возврат Ответ(401, "invalid_token", "Неверный или заблокированный токен");
		КонецЕсли;
		Если Маршрут = "ping" Тогда
			Возврат Ответ(200);
		КонецЕсли;

		ТипТела = ?(Маршрут = "json", "application/json", "application/octet-stream");
		ЧастиТипа = СтрРазделить(Строка(Запрос.Заголовки.Получить("Content-Type")), ";", Истина);
		ТипИзЗаголовка = НРег(СокрЛП(ЧастиТипа[0]));
		Если ТипИзЗаголовка <> ТипТела Тогда
			Возврат Ответ(415, "unsupported_media_type", "Недопустимый Content-Type");
		КонецЕсли;

		Размер = Запрос.Заголовки.Получить("Content-Length");
		Если Размер <> Неопределено Тогда
			Если Не Соответствует(Размер, "\A[0-9]{1,20}\z") Тогда
				Возврат Ответ(400, "bad_request", "Некорректный Content-Length");
			КонецЕсли;
			Размер = Число(Размер);
		КонецЕсли;
		Идентификатор = Строка(Новый УникальныйИдентификатор);
		Если Маршрут = "json" Тогда
			Возврат ПринятьJSON(Запрос, Клиент, Идентификатор, Размер);
		ИначеЕсли Маршрут = "file" Тогда
			Возврат ПринятьФайл(Запрос, Клиент, Идентификатор, Размер);
		Иначе
			Возврат Ответ(400, "bad_request", "Неизвестная операция");
		КонецЕсли;
	Исключение
		// Исключение платформы может содержать внутренние данные.
		Возврат Ответ(500, "internal_error", "Внутренняя ошибка приёма");
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ищет одного действующего клиента по SHA-256. Если найден дубликат, доступ закрыт.
//
// Параметры:
//  Токен - Строка, Неопределено - значение X-Token.
//
// Возвращаемое значение:
//  СправочникСсылка.ТЛМ_Клиенты, Неопределено - клиент или отказ.
Функция КлиентПоТокену(Знач Токен)
	Если Не Соответствует(Токен, "\A[0-9a-f]{64}\z") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Найденные = КлиентыПоХешу(ХешТокена(Токен));
	Если Найденные.Количество() = 1 И Найденные[0].Активен И Не Найденные[0].ПометкаУдаления Тогда
		Возврат Найденные[0].Ссылка;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Читает до двух совпадений из собственного справочника.
//
// Параметры:
//  Хеш - Строка - SHA-256 токена.
//
// Возвращаемое значение:
//  ТаблицаЗначений - ссылки и признаки доступа.
Функция КлиентыПоХешу(Знач Хеш)
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 2
		|	Клиенты.Ссылка, Клиенты.Активен, Клиенты.ПометкаУдаления
		|ИЗ Справочник.ТЛМ_Клиенты КАК Клиенты
		|ГДЕ Клиенты.ХешТокена = &Хеш
		|УПОРЯДОЧИТЬ ПО Клиенты.Ссылка");
	Запрос.УстановитьПараметр("Хеш", Хеш);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Считает SHA-256 для поиска и записи в справочник.
//
// Параметры:
//  Токен - Строка - 64 ASCII-символа, которые прислал клиент.
//
// Возвращаемое значение:
//  Строка - хеш в hex.
Функция ХешТокена(Знач Токен)
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Токен, КодировкаТекста.UTF8, Ложь));
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));
КонецФункции

// Проверяет полномочия и передаёт изменение под блокировку.
//
// Параметры:
//  Клиент - СправочникСсылка.ТЛМ_Клиенты - клиент.
//  Активен - Булево - выдать доступ или отозвать.
//  Токен - Строка - новый токен или пустая строка.
//
// Возвращаемое значение:
//  Структура - статус. Секрет добавляется только после фиксации.
Функция ИзменитьДоступ(Знач Клиент, Знач Активен, Знач Токен)
	Если Не РольДоступна("ТЛМ_АдминистраторСервера") Тогда
		Возврат СтатусДоступа("invalid_settings", "Требуется роль администратора телеметрии");
	КонецЕсли;
	Если ТипЗнч(Клиент) <> Тип("СправочникСсылка.ТЛМ_Клиенты") Или Не ЗначениеЗаполнено(Клиент) Тогда
		Возврат СтатусДоступа("bad_request", "Укажите ссылку на клиента");
	КонецЕсли;
	Если Активен И Не Соответствует(Токен, "\A[0-9a-f]{64}\z") Тогда
		Возврат СтатусДоступа("bad_request", "Ожидается 64 строчных шестнадцатеричных символа");
	КонецЕсли;
	Если ТранзакцияАктивна() Тогда
		Возврат СтатусДоступа("bad_request", "Вызовите метод вне транзакции");
	КонецЕсли;

	ФиксацияНачата = Ложь;
	Попытка
		Хеш = ?(Активен, ХешТокена(Токен), "");
		Статус = ЗаписатьДоступ(Клиент, Активен, Хеш, ФиксацияНачата);
	Исключение
		Возврат СтатусДоступа("storage_error", "Изменение доступа не подтверждено", ФиксацияНачата);
	КонецПопытки;
	Если Не Статус.Успех Тогда
		Возврат Статус;
	КонецЕсли;

	Если Активен Тогда
		Статус.Вставить("Токен", Токен);
	КонецЕсли;
	Возврат Статус;
КонецФункции

// Под блокировкой проверяет уникальность хеша и меняет карточку клиента.
// Параметры:
//  Клиент - СправочникСсылка.ТЛМ_Клиенты - получатель доступа.
//  Активен - Булево - признак разрешения приёма.
//  Хеш - Строка - SHA-256 или пустая строка при блокировке.
//  ФиксацияНачата - Булево - выход, помогает различить отказ и неизвестный итог.
// Возвращаемое значение:
//  Структура - итог изменения. Исключение передаётся вызывающему методу.
Функция ЗаписатьДоступ(Знач Клиент, Знач Активен, Знач Хеш, ФиксацияНачата)
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Блокировка.Добавить("Справочник.ТЛМ_Клиенты");
		Блокировка.Заблокировать();
		Карточка = Клиент.ПолучитьОбъект();
		Если Карточка = Неопределено Или Карточка.ПометкаУдаления Тогда
			Статус = СтатусДоступа("bad_request", "Клиент отсутствует или помечен на удаление");
		ИначеЕсли Активен И КлиентыПоХешу(Хеш).Количество() > 0 Тогда
			Статус = СтатусДоступа("bad_request", "Создайте новый случайный токен");
		Иначе
			Карточка.ХешТокена = Хеш;
			Карточка.Активен = Активен;
			Карточка.Записать();
			ФиксацияНачата = Истина;
			Статус = СтатусДоступа();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Статус;
КонецФункции

// Собирает результат административного вызова.
//
// Параметры:
//  Код - Строка - машинный код.
//  Текст - Строка - безопасное пояснение.
//  Неизвестно - Булево - итог фиксации не подтверждён.
//
// Возвращаемое значение:
//  Структура - шесть полей результата.
Функция СтатусДоступа(Знач Код = "", Знач Текст = "", Знач Неизвестно = Ложь)
	Успех = ПустаяСтрока(Код);
	СостояниеОтказа = ?(Неизвестно, "НЕИЗВЕСТНО", "ОТКЛОНЕНО");
	Состояние = ?(Успех, "ПОДТВЕРЖДЕНО", СостояниеОтказа);
	Возврат Новый Структура("Успех,КодОшибки,ОписаниеОшибки,КодHTTP,Идентификатор,Состояние",
		Успех, Код, Текст, 0, "", Состояние);
КонецФункции

// Читает до лимита плюс один байт и сохраняет исходный текст без разбора JSON.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - источник текста.
//  Клиент - СправочникСсылка.ТЛМ_Клиенты - отправитель.
//  Идентификатор - Строка - UUID новой записи.
//  Размер - Число, Неопределено - заявленный размер в байтах.
//
// Возвращаемое значение:
//  HTTPСервисОтвет - ID записи или отказ.
Функция ПринятьJSON(Знач Запрос, Знач Клиент, Знач Идентификатор, Знач Размер)
	ЛимитМБ = Константы.ТЛМ_Сервер_МаксимальныйРазмерJSONМБ.Получить();
	Если ЛимитМБ < 0 Тогда
		Возврат Ответ(503, "unavailable", "Проверьте настройку лимита JSON");
	КонецЕсли;
	ЛимитБайт = ?(ЛимитМБ = 0, 10, ЛимитМБ) * 1024 * 1024;
	Если Размер <> Неопределено И Размер > ЛимитБайт Тогда
		Возврат Ответ(413, "payload_too_large", "Превышен лимит JSON");
	КонецЕсли;

	Буфер = Новый ПотокВПамяти;
	Вход = Запрос.ПолучитьТелоКакПоток();
	БайтПолучено = 0;
	Если Вход <> Неопределено Тогда
		БайтПолучено = Вход.КопироватьВ(Буфер, ЛимитБайт + 1);
		Вход.Закрыть();
	КонецЕсли;
	Данные = Буфер.ЗакрытьИПолучитьДвоичныеДанные();
	Если БайтПолучено > ЛимитБайт Тогда
		Возврат Ответ(413, "payload_too_large", "Превышен лимит JSON");
	КонецЕсли;
	Если БайтПолучено = 0 Или (Размер <> Неопределено И Размер <> БайтПолучено) Тогда
		Возврат Ответ(400, "bad_request", "Пустое или неполное тело JSON");
	КонецЕсли;

	Текст = ТекстUTF8(Данные);
	Если Текст = Неопределено Тогда
		Возврат Ответ(400, "invalid_encoding", "Ожидается UTF-8 без BOM");
	КонецЕсли;

	Попытка
		Запись = РегистрыСведений.ТЛМ_ПолученныеJSON.СоздатьМенеджерЗаписи();
		ЗаполнитьИсторию(Запись, Клиент, Идентификатор);
		Запись.JSON = Текст;
		Запись.Записать(Ложь);
	Исключение
		Возврат Ответ(500, "storage_error", "Сохранение JSON не подтверждено");
	КонецПопытки;
	Возврат Ответ(201, , , Идентификатор);
КонецФункции

// Обратное преобразование выявляет неверные байты даже при автоматической подмене символов.
//
// Параметры:
//  Данные - ДвоичныеДанные - исходные байты в пределах лимита JSON.
//
// Возвращаемое значение:
//  Строка, Неопределено - точный текст UTF-8 или ошибка кодировки.
Функция ТекстUTF8(Знач Данные)
	Попытка
		Текст = ПолучитьСтрокуИзДвоичныхДанных(Данные, КодировкаТекста.UTF8);
		ОбратныеБайты = ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь);
		Если Лев(Текст, 1) <> Символ(65279) И Base64Строка(Данные) = Base64Строка(ОбратныеБайты) Тогда
			Возврат Текст;
		КонецЕсли;
	Исключение
		// При ошибке преобразования ничего не сохраняем.
		Возврат Неопределено;
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

// Копирует тело запроса в отдельный файл и фиксирует путь в регистре.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - источник байтов.
//  Клиент - СправочникСсылка.ТЛМ_Клиенты - отправитель.
//  Идентификатор - Строка - UUID нового файла и записи.
//  Размер - Число, Неопределено - заявленный размер.
//
// Возвращаемое значение:
//  HTTPСервисОтвет - ID после записи файла и регистра или отказ.
Функция ПринятьФайл(Знач Запрос, Знач Клиент, Знач Идентификатор, Знач Размер)
	Имя = Запрос.ПараметрыЗапроса.Получить("name");
	Если Не Соответствует(Имя, "\A[^\\/:\x00-\x1F\x7F]{1,255}\z")
		Или СтрДлина(Имя) > 255 Или ПустаяСтрока(Имя) Или Имя = "." Или Имя = ".." Тогда
		Возврат Ответ(400, "invalid_filename", "Укажите исходное имя файла без пути");
	КонецЕсли;

	Каталог = Константы.ТЛМ_Сервер_КаталогФайлов.Получить();
	Разделитель = ПолучитьРазделительПути();
	Если Не АбсолютныйКаталог(Каталог, Разделитель) Тогда
		Возврат Ответ(503, "unavailable", "Задайте абсолютный каталог приёма файлов");
	КонецЕсли;
	Если Прав(Каталог, 1) <> Разделитель Тогда
		Каталог = Каталог + Разделитель;
	КонецЕсли;

	ОтносительныйПуть = Идентификатор + ".bin";
	КонечныйПуть = Каталог + ОтносительныйПуть;
	ВременныйПуть = Каталог + Идентификатор + ".tmp";
	ФайлНаш = Ложь;
	ФайлПеремещен = Ложь;
	МожноУдалитьФайл = Истина;
	Выход = Неопределено;
	Попытка
		Папка = Новый Файл(Каталог);
		Если Не Папка.Существует() Или Не Папка.ЭтоКаталог() Тогда
			Возврат Ответ(503, "unavailable", "Каталог приёма файлов недоступен");
		КонецЕсли;

		// Клиентское имя хранится только в БД. Корень защищает ACL ОС.
		Выход = Новый ФайловыйПоток(ВременныйПуть, РежимОткрытияФайла.СоздатьНовый);
		ФайлНаш = Истина;
		БайтПолучено = СкопироватьТело(Запрос, Выход);
		Выход.Закрыть();
		Выход = Неопределено;
		ВременныйФайл = Новый Файл(ВременныйПуть);
		Если Размер <> Неопределено И БайтПолучено <> Размер Тогда
			УдалитьСвойФайл(ВременныйПуть);
			Возврат Ответ(400, "bad_request", "Получены не все байты файла");
		КонецЕсли;

		КонечныйФайл = Новый Файл(КонечныйПуть);
		Если ВременныйФайл.Размер() <> БайтПолучено Или КонечныйФайл.Существует() Тогда
			УдалитьСвойФайл(ВременныйПуть);
			Возврат Ответ(500, "storage_error", "Не удалось подготовить файл");
		КонецЕсли;

		ПереместитьФайл(ВременныйПуть, КонечныйПуть);
		ФайлПеремещен = Истина;
		Запись = РегистрыСведений.ТЛМ_ПолученныеФайлы.СоздатьМенеджерЗаписи();
		ЗаполнитьИсторию(Запись, Клиент, Идентификатор);
		Запись.ОригинальноеИмя = Имя;
		Запись.РазмерБайт = БайтПолучено;
		Запись.ОтносительныйПуть = ОтносительныйПуть;
		ЗаписатьФайлВРегистр(Запись, МожноУдалитьФайл);
	Исключение
		ЗакрытьПоток(Выход);
		Если ФайлНаш И МожноУдалитьФайл Тогда
			УдалитьСвойФайл(?(ФайлПеремещен, КонечныйПуть, ВременныйПуть));
		КонецЕсли;
		// При неизвестном результате фиксации файл может уже иметь запись в БД.
		Возврат Ответ(500, "storage_error", "Сохранение файла не подтверждено");
	КонецПопытки;
	Возврат Ответ(201, , , Идентификатор);
КонецФункции

// Проверяет абсолютный путь для текущей ОС без переходов к родителю.
//
// Параметры:
//  Каталог - Строка - корень хранения.
//  Разделитель - Строка - разделитель пути ОС.
//
// Возвращаемое значение:
//  Булево - путь допустим.
Функция АбсолютныйКаталог(Знач Каталог, Знач Разделитель)
	Если Разделитель = "/" Тогда
		Шаблон = "\A/[^\x00-\x1F*?]*\z";
	Иначе
		Шаблон = "\A[A-Za-z]:\\[^\x00-\x1F*?]*\z";
	КонецЕсли;
	Возврат Соответствует(Каталог, Шаблон)
		И Не Соответствует(Каталог, "(^|[/\\])\.{1,2}([/\\]|\z)");
КонецФункции

// Заполняет измерения новой строки и время в UTC.
//
// Параметры:
//  Запись - РегистрСведенийМенеджерЗаписи - новая запись.
//  Клиент - СправочникСсылка.ТЛМ_Клиенты - отправитель.
//  Идентификатор - Строка - UUID принятого сообщения.
Процедура ЗаполнитьИсторию(Запись, Знач Клиент, Знач Идентификатор)
	Запись.Клиент = Клиент;
	Запись.ИдентификаторСообщения = Идентификатор;
	Запись.ДатаПолучения = ТекущаяУниверсальнаяДата();
КонецПроцедуры

// Записывает строку под новой транзакцией. Если начало фиксации подтверждено
// лишь локально, оставляем файл до ручной сверки БД и диска.
// Параметры:
//  Запись - РегистрСведенийМенеджерЗаписи.ТЛМ_ПолученныеФайлы - готовая запись.
//  МожноУдалитьФайл - Булево - выход, определяет очистку после исключения.
Процедура ЗаписатьФайлВРегистр(Запись, МожноУдалитьФайл)
	МожноУдалитьФайл = Ложь;
	НачатьТранзакцию();
	Попытка
		ФиксацияНачата = Ложь;
		Запись.Записать(Ложь);
		ФиксацияНачата = Истина;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		МожноУдалитьФайл = Не ФиксацияНачата;
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

// Копирует полный поток тела. Поток входа закрывается даже при ошибке.
// Параметры:
//  Запрос - HTTPСервисЗапрос - источник бинарных данных.
//  Выход - ФайловыйПоток - временный файл.
// Возвращаемое значение:
//  Число - фактически скопированные байты.
Функция СкопироватьТело(Знач Запрос, Знач Выход)
	Вход = Запрос.ПолучитьТелоКакПоток();
	Если Вход = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Количество = Вход.КопироватьВ(Выход);
		Вход.Закрыть();
	Исключение
		ЗакрытьПоток(Вход);
		ВызватьИсключение;
	КонецПопытки;
	Возврат Количество;
КонецФункции

// Освобождает поток после отказа, сохраняя первичную ошибку операции.
//
// Параметры:
//  Поток - Поток, Неопределено - открытый поток.
Процедура ЗакрытьПоток(Знач Поток)
	Если Поток = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Поток.Закрыть();
	Исключение
		Возврат;
	КонецПопытки;
КонецПроцедуры

// Удаляет временный или заведомо незафиксированный файл этого запроса.
//
// Параметры:
//  Путь - Строка - точный путь, сформированный сервером без маски.
Процедура УдалитьСвойФайл(Знач Путь)
	Попытка
		УдалитьФайлы(Путь);
	Исключение
		Возврат;
	КонецПопытки;
КонецПроцедуры

// Проверяет непустую строку по шаблону.
//
// Параметры:
//  Значение - Произвольный - проверяемое значение.
//  Шаблон - Строка - регулярное выражение.
//
// Возвращаемое значение:
//  Булево - шаблон найден.
Функция Соответствует(Знач Значение, Знач Шаблон)
	Возврат ТипЗнч(Значение) = Тип("Строка") И СтрДлина(Значение) > 0
		И СтрНайтиПоРегулярномуВыражению(Значение, Шаблон).НачальнаяПозиция > 0;
КонецФункции

// Готовит HTTP-ответ с коротким телом JSON без внутренних данных.
//
// Параметры:
//  КодHTTP - Число - HTTP-статус.
//  Код - Строка - машинный код отказа.
//  Сообщение - Строка - безопасный текст отказа.
//  Идентификатор - Строка - UUID сохранённой записи при успехе POST.
//
// Возвращаемое значение:
//  HTTPСервисОтвет - UTF-8 без BOM.
Функция Ответ(Знач КодHTTP, Знач Код = "", Знач Сообщение = "", Знач Идентификатор = "")
	Успех = ПустаяСтрока(Код);
	Тело = Новый Структура("ok", Успех);
	Если Не Успех Тогда
		Тело.Вставить("error", Код);
		Тело.Вставить("message", Сообщение);
	Иначе
		Если Не ПустаяСтрока(Идентификатор) Тогда
			Тело.Вставить("id", Идентификатор);
		КонецЕсли;
	КонецЕсли;
	Писатель = Новый ЗаписьJSON;
	Писатель.УстановитьСтроку();
	ЗаписатьJSON(Писатель, Тело);
	ОтветHTTP = Новый HTTPСервисОтвет(КодHTTP);
	ОтветHTTP.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	ОтветHTTP.Заголовки.Вставить("Cache-Control", "no-store");
	ОтветHTTP.УстановитьТелоИзДвоичныхДанных(
		ПолучитьДвоичныеДанныеИзСтроки(Писатель.Закрыть(), КодировкаТекста.UTF8, Ложь));
	Возврат ОтветHTTP;
КонецФункции

