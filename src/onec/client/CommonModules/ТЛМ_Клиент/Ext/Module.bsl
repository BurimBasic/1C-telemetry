#Область ПрограммныйИнтерфейс

// Версия исходников расширения.
// Возвращаемое значение:
//  Строка - версия, например "1.0.2-dev".
Функция Версия() Экспорт
	Возврат "1.0.2-dev";
КонецФункции

// Отправляет готовый текст JSON одним POST в UTF-8.
//
// Параметры:
//  JSON - Строка - документ в исходном виде.
//
// Возвращаемое значение:
//  Структура - итог доставки. При успехе Идентификатор содержит UUID записи.
//
// Пример:
//  Итог = ТЛМ_Клиент.ОтправитьJSON("{""статус"":""готово""}");
Функция ОтправитьJSON(Знач JSON) Экспорт
	Если ТипЗнч(JSON) <> Тип("Строка") Или СтрДлина(JSON) = 0 Тогда
		Возврат Результат("bad_request", "Передайте готовую строку JSON");
	КонецЕсли;
	Возврат Отправить("json", JSON);
КонецФункции

// Отправляет один файл целиком. Путь должен быть доступен процессу 1С.
//
// Параметры:
//  ПутьКФайлу - Строка - путь к готовому неизменяемому файлу.
//
// Возвращаемое значение:
//  Структура - итог доставки. При успехе Идентификатор содержит UUID записи.
//
// Пример:
//  Итог = ТЛМ_Клиент.ОтправитьФайл("C:\Backup\report.log");
Функция ОтправитьФайл(Знач ПутьКФайлу) Экспорт
	Если ТипЗнч(ПутьКФайлу) <> Тип("Строка") Или ПустаяСтрока(ПутьКФайлу) Тогда
		Возврат Результат("file_not_found", "Задайте путь к файлу");
	КонецЕсли;
	Возврат Отправить("file", ПутьКФайлу);
КонецФункции

// Проверяет HTTPS и токен без записи в историю.
//
// Возвращаемое значение:
//  Структура - итог проверки, Идентификатор пустой.
//
// Пример:
//  СвязьЕсть = ТЛМ_Клиент.ПроверитьПодключение().Успех;
Функция ПроверитьПодключение() Экспорт
	Возврат Отправить("ping");
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Читает настройки, готовит запрос и делает один HTTP-вызов.
//
// Параметры:
//  Маршрут - Строка - ping, file или json.
//  Данные - Строка - путь или готовый JSON.
//
// Возвращаемое значение:
//  Структура - итог. Исключение после начала вызова оставляет итог неизвестным.
Функция Отправить(Знач Маршрут, Знач Данные = "")
	Попытка
		Адрес = РазобратьАдрес(Константы.ТЛМ_Клиент_АдресСервера.Получить());
		Токен = Константы.ТЛМ_Клиент_Токен.Получить();
		Таймаут = Константы.ТЛМ_Клиент_Таймаут.Получить();
		ПутьКPEM = Константы.ТЛМ_Клиент_ПутьКСертификату.Получить();
		Если Адрес = Неопределено Или Не Соответствует(Токен, "\A[0-9a-f]{64}\z") Или Таймаут < 0 Тогда
			Возврат Результат("invalid_settings", "Проверьте HTTPS-адрес, токен и таймаут");
		КонецЕсли;
		Таймаут = ?(Таймаут = 0, 60, Таймаут);
		Запрос = Новый HTTPЗапрос(Адрес.Путь + Маршрут);
		Запрос.Заголовки.Вставить("X-Token", Токен);
		Запрос.Заголовки.Вставить("Accept", "application/json");
	Исключение
		Возврат Результат("invalid_settings", "Проверьте настройки и права на чтение констант");
	КонецПопытки;

	Если Маршрут = "file" Тогда
		Попытка
			Файл = Новый Файл(Данные);
			Если Не Файл.Существует() Или Не Файл.ЭтоФайл() Тогда
				Возврат Результат("file_not_found", "По указанному пути файл не найден");
			КонецЕсли;
			Имя = КодироватьСтроку(Файл.Имя, СпособКодированияСтроки.КодировкаURL, "UTF-8");
			Запрос.АдресРесурса = Запрос.АдресРесурса + "?name=" + Имя;
			Запрос.Заголовки.Вставить("Content-Type", "application/octet-stream");
			// Платформа открывает файл сама. BSL не читает содержимое в память.
			Запрос.УстановитьИмяФайлаТела(Файл.ПолноеИмя);
		Исключение
			Возврат Результат("file_read_error", "Проверьте право процесса 1С читать файл");
		КонецПопытки;
	ИначеЕсли Маршрут = "json" Тогда
		Попытка
			Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
			Запрос.УстановитьТелоИзДвоичныхДанных(
				ПолучитьДвоичныеДанныеИзСтроки(Данные, КодировкаТекста.UTF8, Ложь));
		Исключение
			Возврат Результат("bad_request", "Не удалось подготовить исходный текст в UTF-8");
		КонецПопытки;
	КонецЕсли;

	Попытка
		Если ПустаяСтрока(ПутьКPEM) Тогда
			Доверие = Новый СертификатыУдостоверяющихЦентровОС;
		Иначе
			Доверие = Новый СертификатыУдостоверяющихЦентровФайл(ПутьКPEM);
		КонецЕсли;
		TLS = Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Доверие);
		Соединение = Новый HTTPСоединение(Адрес.Сервер, Адрес.Порт, , , , Таймаут, TLS, Ложь);
	Исключение
		Возврат Результат("tls_error", "Проверьте настройку доверия к сертификату");
	КонецПопытки;

	Попытка
		// Вызов HTTP-метода 1С возвращает статус. Location из ответа не используем.
		Ответ = Соединение.ВызватьHTTPМетод(?(Маршрут = "ping", "GET", "POST"), Запрос);
	Исключение
		Возврат Результат("connection_error", "HTTPS-запрос не подтверждён. Проверьте связь и TLS", , , Истина);
	КонецПопытки;
	Возврат РазобратьОтвет(Ответ, Маршрут = "ping");
КонецФункции

// Выделяет HTTPS-хост, порт и путь.
//
// Параметры:
//  Адрес - Строка - URL корня без данных входа, параметров и фрагмента.
//
// Возвращаемое значение:
//  Структура, Неопределено - разобранный адрес или отказ.
Функция РазобратьАдрес(Знач Адрес)
	СхемаHTTPS = "https://";
	Если НРег(Лев(Адрес, СтрДлина(СхемаHTTPS))) <> СхемаHTTPS Тогда
		Возврат Неопределено;
	КонецЕсли;
	АдресБезСхемы = Сред(Адрес, СтрДлина(СхемаHTTPS) + 1);
	ПозицияПути = СтрНайти(АдресБезСхемы, "/");
	Если ПозицияПути = 0 Тогда
		ХостИПорт = АдресБезСхемы;
		Путь = "/";
	Иначе
		ХостИПорт = Лев(АдресБезСхемы, ПозицияПути - 1);
		Путь = Сред(АдресБезСхемы, ПозицияПути);
	КонецЕсли;
	Если Не Соответствует(ХостИПорт, "\A([A-Za-z0-9][A-Za-z0-9.-]*|\[[0-9A-Fa-f:.]+\])(:[0-9]{1,5})?\z")
		Или Не Соответствует(Путь, "\A/([A-Za-z0-9._~/-]|%[0-9A-Fa-f]{2})*\z")
		Или Соответствует(НРег(Путь), "%(0[0-9a-f]|1[0-9a-f]|7f|25|2e|2f|3f|23|5c)")
		Или Соответствует(Путь, "/\.{1,2}(/|\z)|//") Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПозицияПорта = СтрНайти(ХостИПорт, ":", НаправлениеПоиска.СКонца);
	Если ПозицияПорта > СтрНайти(ХостИПорт, "]") Тогда
		Сервер = Лев(ХостИПорт, ПозицияПорта - 1);
		Порт = Число(Сред(ХостИПорт, ПозицияПорта + 1));
	Иначе
		Сервер = ХостИПорт;
		Порт = 443;
	КонецЕсли;
	НаибольшийПортTCP = 65535;
	Если Порт < 1 Или Порт > НаибольшийПортTCP Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Прав(Путь, 1) <> "/" Тогда
		Путь = Путь + "/";
	КонецЕсли;
	Возврат Новый Структура("Сервер,Порт,Путь", Сервер, Порт, Путь);
КонецФункции

// Проверяет HTTP-статус и JSON. Текст удалённого ответа наружу не возвращается.
//
// Параметры:
//  Ответ - HTTPОтвет - результат HTTPS-запроса.
//  ЭтоПроверка - Булево - вызван ping.
//
// Возвращаемое значение:
//  Структура - итог передачи или проверки.
Функция РазобратьОтвет(Знач Ответ, Знач ЭтоПроверка)
	КодHTTP = Ответ.КодСостояния;
	ОжидаемыйКод = ?(ЭтоПроверка, 200, 201);
	Попытка
		Читатель = Новый ЧтениеJSON;
		Читатель.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
		Тело = ПрочитатьJSON(Читатель, Истина);
		Читатель.Закрыть();
		Если ТипЗнч(Тело) <> Тип("Соответствие") Тогда
			Возврат ОшибкаHTTP(КодHTTP);
		КонецЕсли;
		Успех = Тело.Получить("ok");
		Если ТипЗнч(Успех) <> Тип("Булево") Тогда
			Возврат ОшибкаHTTP(КодHTTP);
		КонецЕсли;
		Если Успех И КодHTTP = ОжидаемыйКод Тогда
			Идентификатор = Тело.Получить("id");
			Если ЭтоПроверка И Идентификатор = Неопределено Тогда
				Возврат Результат("", "", КодHTTP);
			КонецЕсли;
			Если Не ЭтоПроверка И Соответствует(Идентификатор,
				"\A[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}\z") Тогда
				Возврат Результат("", "", КодHTTP, Идентификатор);
			КонецЕсли;
		ИначеЕсли Не Успех Тогда
			Ошибка = ОшибкаСервера(КодHTTP, Тело.Получить("error"));
			Если Ошибка <> Неопределено Тогда
				Возврат Ошибка;
			КонецЕсли;
		Иначе
			Возврат ОшибкаHTTP(КодHTTP);
		КонецЕсли;
	Исключение
		// Прокси и веб-сервер могут вернуть HTML или пустое тело.
		Возврат ОшибкаHTTP(КодHTTP);
	КонецПопытки;
	Возврат ОшибкаHTTP(КодHTTP);
КонецФункции

// Проверяет код ошибки API и возвращает локальное описание.
//
// Параметры:
//  КодHTTP - Число - HTTP-статус.
//  Код - Строка, Неопределено - поле error ответа.
//
// Возвращаемое значение:
//  Структура, Неопределено - известная ошибка или неожиданный ответ.
Функция ОшибкаСервера(Знач КодHTTP, Знач Код)
	// Только известная пара HTTP и поля error считается ответом нашего API.
	Ошибки = Новый Соответствие;
	Ошибки.Вставить("400:bad_request", "Сервер отклонил запрос. Проверьте тело и заголовки");
	Ошибки.Вставить("400:invalid_filename", "Сервер отклонил имя файла");
	Ошибки.Вставить("400:invalid_encoding", "Сервер ожидает UTF-8 без BOM");
	Ошибки.Вставить("401:invalid_token", "Токен неверен или отозван");
	Ошибки.Вставить("415:unsupported_media_type", "Сервер отклонил Content-Type");
	Ошибки.Вставить("500:storage_error", "Сохранение на сервере не подтверждено");
	Ошибки.Вставить("500:internal_error", "Сохранение на сервере не подтверждено");
	Ошибки.Вставить("503:unavailable", "Операция временно недоступна. Проверьте настройки сервера");
	Ошибки.Вставить("507:insufficient_storage", "Недостаточно места на сервере");
	Если ТипЗнч(Код) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Текст = Ошибки.Получить(Строка(КодHTTP) + ":" + Код);
	Если Текст = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Результат(Код, Текст, КодHTTP, , КодHTTP = 500);
КонецФункции

// Обрабатывает HTTP-ответ без подтверждённого JSON API.
//
// Параметры:
//  КодHTTP - Число - фактический статус.
//
// Возвращаемое значение:
//  Структура - 413 или неизвестный итог.
Функция ОшибкаHTTP(Знач КодHTTP)
	Если КодHTTP = 413 Тогда
		Возврат Результат("payload_too_large", "Тело превышает допустимый размер запроса", КодHTTP);
	КонецЕсли;
	Возврат Результат("invalid_response", "Нет ожидаемого ответа сервиса телеметрии", КодHTTP, , Истина);
КонецФункции

// Проверяет непустую строку по шаблону.
//
// Параметры:
//  Значение - Произвольный - проверяемое значение.
//  Шаблон - Строка - выражение.
//
// Возвращаемое значение:
//  Булево - шаблон найден.
Функция Соответствует(Знач Значение, Знач Шаблон)
	Возврат ТипЗнч(Значение) = Тип("Строка") И СтрДлина(Значение) > 0
		И СтрНайтиПоРегулярномуВыражению(Значение, Шаблон).НачальнаяПозиция > 0;
КонецФункции

// Собирает шесть полей транспортного результата.
//
// Параметры:
//  Код - Строка - машинный код или пустая строка.
//  Текст - Строка - безопасное пояснение.
//  КодHTTP - Число - HTTP-статус или 0.
//  Идентификатор - Строка - UUID записи при успехе.
//  Неизвестно - Булево - нет надёжного подтверждения результата.
//
// Возвращаемое значение:
//  Структура - итог для кода заказчика.
Функция Результат(Знач Код, Знач Текст, Знач КодHTTP = 0, Знач Идентификатор = "", Знач Неизвестно = Ложь)
	Успех = ПустаяСтрока(Код);
	СостояниеОтказа = ?(Неизвестно, "НЕИЗВЕСТНО", "ОТКЛОНЕНО");
	Состояние = ?(Успех, "ПОДТВЕРЖДЕНО", СостояниеОтказа);
	Возврат Новый Структура("Успех,КодОшибки,ОписаниеОшибки,КодHTTP,Идентификатор,Состояние",
		Успех, Код, Текст, КодHTTP, Идентификатор, Состояние);
КонецФункции

