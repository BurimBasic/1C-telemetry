&НаКлиенте
Перем АдресВыбранногоФайла, ВыборВыполняется;

&НаСервере
// Показывает версию модуля и начальный пример. Открытие формы не отправляет запросы.
// Параметры:
//  Отказ - Булево - признак отказа от открытия.
//  СтандартнаяОбработка - Булево - признак штатной обработки события.
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ВерсияКлиента = ТЛМ_Клиент.Версия();
	ТелоJSON = "{""source"":""telemetry-check"",""value"":42}";
КонецПроцедуры

&НаКлиенте
// Отображает результат запроса GET /ping.
// Параметры:
//  Команда - КомандаФормы - команда проверки подключения.
Процедура ПроверитьПодключение(Команда)
	Попытка
		Результат = ТекстРезультата("Проверка подключения", ПроверитьНаСервере());
	Исключение
		Результат = "Не удалось получить результат проверки из базы-отправителя.";
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
// Передаёт текст поля JSON в клиентский модуль без разбора содержимого.
// Параметры:
//  Команда - КомандаФормы - команда отправки JSON.
Процедура ОтправитьJSON(Команда)
	Попытка
		Результат = ТекстРезультата("Отправка JSON", ОтправитьJSONНаСервере(ТелоJSON));
	Исключение
		Результат = "Результат отправки JSON не получен. Перед повтором проверьте регистр приёмника.";
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
// Выбирает локальный файл и помещает его в хранилище формы на стороне TEST-клиента.
// Параметры:
//  Команда - КомандаФормы - команда выбора файла.
Асинх Процедура ВыбратьФайл(Команда)
	Если ВыборВыполняется = Истина Тогда
		Возврат;
	КонецЕсли;
	ВыборВыполняется = Истина;
	Попытка
		Диалог = Новый ПараметрыДиалогаПомещенияФайлов;
		Диалог.Заголовок = "Выберите файл для отправки телеметрии";
		Загрузка = Ждать ПоместитьФайлНаСерверАсинх(, , , Диалог, УникальныйИдентификатор);
	Исключение
		ВыборВыполняется = Ложь;
		Результат = "Не удалось загрузить выбранный файл в базу-отправитель.";
		Возврат;
	КонецПопытки;
	ВыборВыполняется = Ложь;
	Если ТипЗнч(Загрузка) <> Тип("ОписаниеПомещенногоФайла") Или Загрузка.ПомещениеФайлаОтменено Тогда
		Возврат;
	КонецЕсли;

	ПрежнийАдрес = АдресВыбранногоФайла;
	ИмяФайла = Загрузка.СсылкаНаФайл.Имя;
	АдресВыбранногоФайла = Загрузка.Адрес;
	Результат = "Файл выбран. Для передачи нажмите «Отправить файл».";
	Если ПрежнийАдрес <> Неопределено Тогда
		Попытка
			УдалитьИзВременногоХранилища(ПрежнийАдрес);
		Исключение
			// Данные привязаны к форме и будут удалены платформой при закрытии.
			Возврат;
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
// Отправляет выбранный файл отдельным явным действием пользователя.
// Параметры:
//  Команда - КомандаФормы - команда отправки файла.
Процедура ОтправитьФайл(Команда)
	Если ВыборВыполняется = Истина Тогда
		Результат = "Дождитесь окончания выбора файла.";
		Возврат;
	КонецЕсли;
	Если АдресВыбранногоФайла = Неопределено Тогда
		Результат = "Сначала выберите файл.";
		Возврат;
	КонецЕсли;
	Попытка
		Итог = ОтправитьФайлНаСервере(АдресВыбранногоФайла, ИмяФайла);
		Результат = ТекстРезультата("Отправка файла", Итог);
	Исключение
		Результат = "Результат отправки файла не получен. Перед повтором проверьте регистр приёмника.";
	КонецПопытки;
КонецПроцедуры

&НаСервереБезКонтекста
// Проверяет связь с сервером из текущей базы.
// Возвращаемое значение:
//  Структура - результат ТЛМ_Клиент.ПроверитьПодключение().
Функция ПроверитьНаСервере()
	Возврат ТЛМ_Клиент.ПроверитьПодключение();
КонецФункции

&НаСервереБезКонтекста
// Отправляет введённый текст отдельным запросом из текущей базы.
// Параметры:
//  ТекстJSON - Строка - поле ввода формы.
// Возвращаемое значение:
//  Структура - результат ТЛМ_Клиент.ОтправитьJSON().
Функция ОтправитьJSONНаСервере(Знач ТекстJSON)
	Возврат ТЛМ_Клиент.ОтправитьJSON(ТекстJSON);
КонецФункции

&НаСервереБезКонтекста
// Вызывает штатную отправку для файла, временно сохранённого под исходным именем.
// Параметры:
//  Адрес - Строка - адрес выбранных двоичных данных в хранилище формы.
//  Имя - Строка - исходное имя файла без пути.
// Возвращаемое значение:
//  Структура - исходный результат API либо локальный отказ до начала передачи.
Функция ОтправитьФайлНаСервере(Знач Адрес, Знач Имя)
	Если Не ДопустимоеИмяФайла(Имя) Тогда
		Возврат ОшибкаПодготовкиФайла("invalid_filename", "Имя файла нельзя использовать во временном каталоге.");
	КонецЕсли;

	РабочийКаталог = "";
	Попытка
		Данные = ПолучитьИзВременногоХранилища(Адрес);
		Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда
			Возврат ОшибкаПодготовкиФайла("file_not_found", "Срок хранения файла истёк. Выберите его снова.");
		КонецЕсли;
		Каталог = ПолучитьИмяВременногоФайла("tlm");
		СоздатьКаталог(Каталог);
		РабочийКаталог = Каталог;
		Путь = РабочийКаталог + ПолучитьРазделительПути() + Имя;
		Данные.Записать(Путь);
	Исключение
		ОчиститьРабочийКаталог(РабочийКаталог);
		Возврат ОшибкаПодготовкиФайла("file_read_error", "Не удалось подготовить файл на сервере базы-отправителя.");
	КонецПопытки;

	Попытка
		Итог = ТЛМ_Клиент.ОтправитьФайл(Путь);
	Исключение
		ОчиститьРабочийКаталог(РабочийКаталог);
		ВызватьИсключение;
	КонецПопытки;
	ОчиститьРабочийКаталог(РабочийКаталог);
	Возврат Итог;
КонецФункции

&НаСервереБезКонтекста
// Проверяет, что имя можно использовать как один компонент пути.
// Параметры:
//  Имя - Строка - имя из выбора клиента.
// Возвращаемое значение:
//  Булево - имя допустимо.
Функция ДопустимоеИмяФайла(Знач Имя)
	Если ПустаяСтрока(Имя) Или СтрДлина(Имя) > 255 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНайтиПоРегулярномуВыражению(Имя, "[\\/:<>""|?*\x00-\x1F\x7F]|[. ]\z").НачальнаяПозиция = 0
		И СтрНайтиПоРегулярномуВыражению(Имя,
			"(?i)\A(CON|PRN|AUX|NUL|COM[1-9¹²³]|LPT[1-9¹²³]|CONIN\$|CONOUT\$) *(\.|\z)").НачальнаяПозиция = 0;
КонецФункции

&НаСервереБезКонтекста
// Удаляет временную копию. Ошибка очистки не меняет подтверждённый итог отправки.
// Параметры:
//  Каталог - Строка - собственный созданный каталог или пустая строка.
Процедура ОчиститьРабочийКаталог(Знач Каталог)
	Если Не ПустаяСтрока(Каталог) Тогда
		Попытка
			УдалитьФайлы(Каталог);
		Исключение
			Возврат;
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
// Формирует отказ при локальной подготовке файла с теми же полями, что у клиента.
// Параметры:
//  Код - Строка - причина отказа.
//  Описание - Строка - понятное сообщение.
// Возвращаемое значение:
//  Структура - неотправленная операция.
Функция ОшибкаПодготовкиФайла(Знач Код, Знач Описание)
	Возврат Новый Структура("Успех,КодОшибки,ОписаниеОшибки,КодHTTP,Идентификатор,Состояние",
		Ложь, Код, Описание, 0, "", "ОТКЛОНЕНО");
КонецФункции

&НаКлиенте
// Готовит текст последнего результата. Выводит только поля публичного контракта.
// Параметры:
//  Операция - Строка - название действия пользователя.
//  Итог - Структура - результат клиентского вызова.
// Возвращаемое значение:
//  Строка - состояние, HTTP-код, UUID либо код и описание ошибки.
Функция ТекстРезультата(Знач Операция, Знач Итог)
	Текст = Операция + " - " + Итог.Состояние;
	Если Итог.КодHTTP > 0 Тогда
		Текст = Текст + Символы.ПС + "HTTP " + Строка(Итог.КодHTTP);
	КонецЕсли;
	Если Не ПустаяСтрока(Итог.Идентификатор) Тогда
		Текст = Текст + Символы.ПС + "UUID: " + Итог.Идентификатор;
	КонецЕсли;
	Если Не Итог.Успех Тогда
		Текст = Текст + Символы.ПС + Итог.КодОшибки + " - " + Итог.ОписаниеОшибки;
	КонецЕсли;
	Возврат Текст;
КонецФункции

