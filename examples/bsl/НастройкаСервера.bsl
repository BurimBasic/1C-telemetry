// Задаёт существующий каталог на машине, где работает сервер 1С.
// Параметры:
//  Каталог - Строка - абсолютный путь вне веб-публикации.
// Пример:
//  НастроитьСервер("D:\Telemetry");
Процедура НастроитьСервер(Знач Каталог) Экспорт
	Константы.ТЛМ_Сервер_КаталогФайлов.Установить(Каталог);
	Константы.ТЛМ_Сервер_МаксимальныйРазмерJSONМБ.Установить(10);
КонецПроцедуры

// Создаёт клиента и регистрирует новый секрет. Вызывается администратором.
// Параметры:
//  Название - Строка - понятное имя источника.
//  Токен - Строка - 64 строчных hex-символа из криптографического генератора.
// Возвращаемое значение:
//  Структура - Клиент и Итог. Успешный Итог содержит секрет, храните его закрыто.
// Пример:
//  Источник = ДобавитьОтправителя("Резервные копии", ТокенИзНастроек);
Функция ДобавитьОтправителя(Знач Название, Знач Токен) Экспорт
	Карточка = Справочники.ТЛМ_Клиенты.СоздатьЭлемент();
	Карточка.Наименование = Название;
	Карточка.Записать();
	Итог = ТЛМ_Сервер.СгенерироватьТокен(Карточка.Ссылка, Токен);
	Возврат Новый Структура("Клиент,Итог", Карточка.Ссылка, Итог);
КонецФункции

// Отзывает токен клиента. Для ротации вызовите СгенерироватьТокен с новым секретом.
// Параметры:
//  Клиент - СправочникСсылка.ТЛМ_Клиенты - существующий отправитель.
// Возвращаемое значение:
//  Структура - итог отзыва.
// Пример:
//  Итог = ОтозватьДоступ(Источник.Клиент);
Функция ОтозватьДоступ(Знач Клиент) Экспорт
	Возврат ТЛМ_Сервер.ЗаблокироватьКлиента(Клиент);
КонецФункции

