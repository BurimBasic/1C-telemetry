// Задаёт существующий каталог на машине, где работает сервер 1С.
// Параметры:
//  Каталог - Строка - абсолютный путь вне веб-публикации.
// Пример:
//  НастроитьСервер("D:\Telemetry");
Процедура НастроитьСервер(Знач Каталог) Экспорт
	Константы.ТЛМ_Сервер_КаталогФайлов.Установить(Каталог);
	Константы.ТЛМ_Сервер_МаксимальныйРазмерJSONМБ.Установить(10);
КонецПроцедуры

// Создаёт активного клиента и сохраняет токен, выбранный администратором.
// Параметры:
//  Название - Строка - понятное имя источника.
//  Токен - Строка - исходное значение из закрытой настройки.
// Возвращаемое значение:
//  СправочникСсылка.ТЛМ_Клиенты - созданный клиент.
// Пример:
//  Клиент = ДобавитьОтправителя("Тестовый клиент", "123");
Функция ДобавитьОтправителя(Знач Название, Знач Токен) Экспорт
	Карточка = Справочники.ТЛМ_Клиенты.СоздатьЭлемент();
	Карточка.Наименование = Название;
	Карточка.Токен = Токен;
	Карточка.Активен = Истина;
	Карточка.Записать();
	Возврат Карточка.Ссылка;
КонецФункции

// Меняет токен существующей карточки, сохраняя клиентскую историю.
// Параметры:
//  Клиент - СправочникСсылка.ТЛМ_Клиенты - существующий отправитель.
//  НовыйТокен - Строка - новое исходное значение.
// Пример:
//  СменитьТокен(Клиент, ТокенИзНастроек);
Процедура СменитьТокен(Знач Клиент, Знач НовыйТокен) Экспорт
	Карточка = Клиент.ПолучитьОбъект();
	Карточка.Токен = НовыйТокен;
	Карточка.Записать();
КонецПроцедуры

// Запрещает новые запросы клиента, сохраняя его карточку и историю.
// Параметры:
//  Клиент - СправочникСсылка.ТЛМ_Клиенты - существующий отправитель.
// Пример:
//  ОтозватьДоступ(Клиент);
Процедура ОтозватьДоступ(Знач Клиент) Экспорт
	Карточка = Клиент.ПолучитьОбъект();
	Карточка.Активен = Ложь;
	Карточка.Записать();
КонецПроцедуры

