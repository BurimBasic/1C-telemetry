// Устанавливает настройки для исходящих запросов в административном сеансе.
// Параметры:
//  Адрес - Строка - полный HTTPS URL корня сервиса.
//  Токен - Строка - секрет клиента, переданный защищённым каналом.
//  ПутьКСертификату - Строка - публичный PEM или пустая строка для системного доверия.
// Пример:
//  НастроитьКлиент("https://server.example/central/hs/telemetry/", ТокенИзНастроек);
Процедура НастроитьКлиент(Знач Адрес, Знач Токен, Знач ПутьКСертификату = "") Экспорт
	Константы.ТЛМ_Клиент_АдресСервера.Установить(Адрес);
	Константы.ТЛМ_Клиент_Токен.Установить(Токен);
	Константы.ТЛМ_Клиент_ПутьКСертификату.Установить(ПутьКСертификату);
	Константы.ТЛМ_Клиент_Таймаут.Установить(60);
КонецПроцедуры

// Проверяет связь, отправляет тестовый JSON и файл. При отказе сообщает итог.
// Параметры:
//  ПутьКФайлу - Строка - существующий файл, доступный процессу 1С.
// Пример:
//  ПроверитьИОтправить("C:\Backup\report.log");
Процедура ПроверитьИОтправить(Знач ПутьКФайлу) Экспорт
	Итог = ТЛМ_Клиент.ПроверитьПодключение();
	Если Итог.Успех Тогда
		Итог = ТЛМ_Клиент.ОтправитьJSON("{""результат"":""готово"",""строки"":[1,2]}");
	КонецЕсли;
	Если Итог.Успех Тогда
		Итог = ТЛМ_Клиент.ОтправитьФайл(ПутьКФайлу);
	КонецЕсли;
	Если Не Итог.Успех Тогда
		Сообщить(Итог.Состояние + ": " + Итог.ОписаниеОшибки);
	КонецЕсли;
КонецПроцедуры

