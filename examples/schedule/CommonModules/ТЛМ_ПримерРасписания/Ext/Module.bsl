// Пример:
//  ТЛМ_ПримерРасписания.Выполнить();
// При отказе пишет стабильный код в журнал. Повтор определяет расписание заказчика.
Процедура Выполнить() Экспорт
	Итог = ТЛМ_Клиент.ОтправитьJSON("{""source"":""schedule-test"",""utc"":"""
		+ Формат(ТекущаяУниверсальнаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss") + "Z""}");
	Если Не Итог.Успех Тогда
		ЗаписьЖурналаРегистрации("ТЛМ.ОтправкаПоРасписанию", УровеньЖурналаРегистрации.Предупреждение,
			, , Итог.Состояние + " " + Итог.КодОшибки);
	КонецЕсли;
КонецПроцедуры

